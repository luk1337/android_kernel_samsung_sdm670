+/* TEMP debug: print the start of a buffer from process context */
+static int cam_mem_dbg_hdl;
+static void cam_mem_dbg_fn(struct work_struct *w)
+{
+	int idx = CAM_MEM_MGR_GET_HDL_IDX(cam_mem_dbg_hdl);
+	struct dma_buf *buf;
+	u32 *va;
+	u32 mx __maybe_unused = 0;
+	size_t k;
+
+	if (idx <= 0 || idx >= CAM_MEM_BUFQ_MAX || !tbl.bufq[idx].active)
+		return;
+	buf = tbl.bufq[idx].dma_buf;
+	if (!buf || dma_buf_begin_cpu_access(buf, DMA_FROM_DEVICE))
+		return;
+	va = dma_buf_vmap(buf);
+	if (va) {
+		u8 *p8 = (u8 *)va;
+		size_t off = 0, n = min_t(size_t, buf->size, 262144), hb[8] = {0};
+		u64 sum = 0;
+
+		for (k = 0; k < n && off + k < buf->size; k++) {
+			sum += p8[off + k];
+			hb[p8[off + k] >> 5]++;
+		}
+		pr_info("DBG RAW size %zu w %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x | +1000 %08x %08x %08x %08x %08x %08x\n",
+			buf->size, va[0], va[1], va[2], va[3], va[4], va[5], va[6], va[7], va[8], va[9], va[10], va[11],
+			va[1000], va[1001], va[1002], va[1003], va[1004], va[1005]);
+		dma_buf_vunmap(buf, va);
+	}
+	dma_buf_end_cpu_access(buf, DMA_FROM_DEVICE);
+}
+static DECLARE_WORK(cam_mem_dbg_work, cam_mem_dbg_fn);
+void cam_mem_dbg_queue(int hdl)
+{
+	if (work_pending(&cam_mem_dbg_work))
+		return;
+	cam_mem_dbg_hdl = hdl;
+	schedule_work(&cam_mem_dbg_work);
+}
